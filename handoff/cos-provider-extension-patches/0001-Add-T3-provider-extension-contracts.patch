+      if (!await flush() || !current() || providerDrainFences.get(pending.turnId) !== fence) return false;
+      const commit = await ask({ type: 'provider_turn_drain_ready', phase: 'commit', conversationId: pending.conversationId,
+        turnId: pending.turnId, drainToken }, current);
