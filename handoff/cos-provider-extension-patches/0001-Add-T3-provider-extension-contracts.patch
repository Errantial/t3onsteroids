+import { describe, expect, it } from 'vitest';
+import { providerExtensionBuildIdFrom } from '../electron.vite.config.js';
+
+describe('provider extension build identity', () => {
+  const sha = '87AE9D631F82D8DA2F462D910410031AD8F97AC5';
+
+  it('advertises the exact lowercase commit only for a clean tree', () => {
+    expect(providerExtensionBuildIdFrom(sha, '')).toBe(sha.toLowerCase());
+    expect(providerExtensionBuildIdFrom(`\n${sha}\n`, '   ')).toBe(sha.toLowerCase());
+  });
+
+  it('fails closed to development for dirty or invalid provenance', () => {
+    expect(providerExtensionBuildIdFrom(sha, ' M src/main/control-api.ts')).toBe('development');
+    expect(providerExtensionBuildIdFrom('not-a-sha', '')).toBe('development');
+    expect(providerExtensionBuildIdFrom('', '')).toBe('development');
+  });
+});
