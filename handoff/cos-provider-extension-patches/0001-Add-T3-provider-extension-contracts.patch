+++ b/test/provider-turn-drain.test.ts
@@ -0,0 +1,319 @@
+import { promises as fs } from 'node:fs';
+import path from 'node:path';
+import { randomUUID } from 'node:crypto';
+import { afterEach, beforeEach, describe, expect, it } from 'vitest';
+import { defaultConfig, initConfigPath, saveConfig } from '../src/main/config.js';
+import {
+  admitProviderEffect,
+  admitProviderInput,
+  appendEvent,
+  closeProviderTurn,
+  createSession,
+  finalizeProviderTurnDrain,
+  flushSessions,
+  getSession,
+  initSessionStore,
+  markProviderBrowserDrained,
+  markProviderTurnEndRecorded,
+  providerTurnDrainToken,
+  readEvents,
+  resetSessionStoreForTests,
+  sessionsRoot,
+  upsertMessageEvent
+} from '../src/main/session/store.js';
+import { makeTempDir, removeTempDir } from './helpers.js';
+
+let dir = '';
+let serial = 0;
+
+beforeEach(async () => {
+  dir = await makeTempDir('clf-provider-drain-');
+  initConfigPath(dir);
+  initSessionStore(dir);
+  await saveConfig(defaultConfig());
+  serial = 0;
+});
+
+afterEach(async () => {
+  await flushSessions();
+  resetSessionStoreForTests();
+  await removeTempDir(dir);
+  dir = '';
+});
+
+const stored = (text: string) => ({ text, chars: text.length, truncated: false });
+
+async function openProviderTurn(outcome: 'completed' | 'stopped' = 'completed') {
+  serial += 1;
+  const conversationId = `provider-drain-chat-${serial}`;
+  const turnId = `provider-turn-${serial}`;
+  const inputId = randomUUID();
+  const questionId = `provider-question-${serial}`;
+  const answerId = `provider-answer-${serial}`;
+  const started = Date.now() + serial * 100;
+  const session = await createSession({
+    conversationId,
+    title: 'Provider task',
+    providerPolicy: { backgroundWork: 'disabled' },
+    currentProviderTurn: { inputId, state: 'admitted' }
+  });
+
+  await upsertMessageEvent(session.id, {
+    time: started,
+    source: 'app',
+    kind: 'user_message',
+    messageId: questionId,
+    inputId,
+    inputDelivery: 'confirmed',
+    message: stored('Do the provider task.')
+  });
+  await appendEvent(session.id, { time: started + 1, source: 'extension', kind: 'turn_start', turnId });
+  expect(await getSession(session.id)).toMatchObject({ currentProviderTurn: { inputId, state: 'active', turnId } });
+
+  let finalSeq: number | null = null;
+  if (outcome === 'completed') {
+    const final = await upsertMessageEvent(session.id, {
+      time: started + 2,
+      source: 'extension',
+      kind: 'assistant_message',
+      turnId,
+      messageId: answerId,
+      providerMessageId: '11111111-2222-4333-8444-555555555555',
+      state: 'final',
+      final: true,
+      message: stored('Provider result.')
+    });
+    finalSeq = final.event.seq;
+  }
+
+  expect(await closeProviderTurn(session.id, turnId, outcome)).toBe(true);
+  const ended = await appendEvent(session.id, { time: started + 3, source: 'extension', kind: 'turn_end', turnId, outcome });
+  expect(ended.kind).toBe('turn_end');
+  expect(await markProviderTurnEndRecorded(session.id, turnId, outcome, ended.seq)).toBe(true);
+  const closing = await getSession(session.id);
+  expect(closing).toMatchObject({ currentProviderTurn: { inputId, state: 'closing', turnId } });
+  expect(closing?.currentProviderTurn?.drainToken).toEqual(expect.any(String));
+  return { sessionId: session.id, conversationId, turnId, inputId, answerId, started, finalSeq };
+}
+
+describe('provider turn drain high-water', () => {
+  it('binds admission only to the exact confirmed native question', async () => {
+    const conversationId = 'provider-activation-chat';
+    const inputId = randomUUID();
+    const session = await createSession({
+      conversationId,
+      providerPolicy: { backgroundWork: 'disabled' },
+      currentProviderTurn: { inputId, state: 'admitted' }
+    });
+    await appendEvent(session.id, { time: 100, source: 'extension', kind: 'turn_start', turnId: 'wrong-first-turn' });
+    expect((await getSession(session.id))?.currentProviderTurn?.state).toBe('admitted');
+
+    await upsertMessageEvent(session.id, {
+      time: 101,
+      source: 'extension',
+      kind: 'user_message',
+      messageId: 'manual-question',
+      message: stored('Manual question')
+    });
+    expect((await getSession(session.id))?.currentProviderTurn?.state).toBe('admitted');
+
+    await upsertMessageEvent(session.id, {
+      time: 102,
+      source: 'app',
+      kind: 'user_message',
+      messageId: 'provider-question',
+      inputId,
+      inputDelivery: 'confirmed',
+      message: stored('Provider question')
+    });
+    // The already-open turn belongs to the earlier manual question. Exact question identity stops stealing it.
+    expect((await getSession(session.id))?.currentProviderTurn?.state).toBe('admitted');
+
+    await appendEvent(session.id, { time: 103, source: 'extension', kind: 'turn_end', turnId: 'wrong-first-turn', outcome: 'completed' });
+    await appendEvent(session.id, { time: 104, source: 'extension', kind: 'turn_start', turnId: 'provider-owned-turn' });
+    expect(await getSession(session.id)).toMatchObject({ currentProviderTurn: { inputId, state: 'active', turnId: 'provider-owned-turn' } });
+  });
+
+  it('requires the exact two-phase token and seals one authoritative final snapshot', async () => {
+    const opened = await openProviderTurn('completed');
+    expect(await admitProviderEffect(opened.conversationId, opened.sessionId)).toBe('refused');
+    expect(await finalizeProviderTurnDrain(opened.sessionId, opened.conversationId, opened.turnId)).toBeNull();
+
+    const drainToken = await providerTurnDrainToken(opened.sessionId, opened.conversationId, opened.turnId);
+    expect(drainToken).toEqual(expect.any(String));
+    expect(await markProviderBrowserDrained(opened.sessionId, opened.conversationId, opened.turnId, randomUUID())).toBe(false);
+    expect(await markProviderBrowserDrained(opened.sessionId, opened.conversationId, opened.turnId, drainToken!)).toBe(true);
+
+    const marker = await finalizeProviderTurnDrain(opened.sessionId, opened.conversationId, opened.turnId);
+    expect(marker).toMatchObject({
+      kind: 'turn_drained',
+      turnId: opened.turnId,
+      inputId: opened.inputId,
+      highWaterSeq: marker?.seq,
+      finalAssistantSeq: opened.finalSeq
+    });
+    expect((await getSession(opened.sessionId))?.currentProviderTurn).toMatchObject({
+      state: 'drained', turnId: opened.turnId, drainToken, browserDrained: true,
+      drainedSeq: marker?.seq, finalAssistantSeq: opened.finalSeq
+    });
+
+    const replay = await finalizeProviderTurnDrain(opened.sessionId, opened.conversationId, opened.turnId);
+    expect(replay?.seq).toBe(marker?.seq);
+    expect((await readEvents(opened.sessionId, { kinds: ['turn_drained'] }))).toHaveLength(1);
+    // A lost commit reply is safe to replay after the marker already exists.
+    expect(await markProviderBrowserDrained(opened.sessionId, opened.conversationId, opened.turnId, drainToken!)).toBe(true);
+  });
+
+  it('selects the latest authoritative final revision that reached custody before browser high-water', async () => {
+    const opened = await openProviderTurn('completed');
+    const corrected = await upsertMessageEvent(opened.sessionId, {
+      time: opened.started + 10,
+      source: 'extension',
+      kind: 'assistant_message',
+      turnId: opened.turnId,
+      messageId: opened.answerId,
+      providerMessageId: '11111111-2222-4333-8444-555555555555',
+      state: 'final',
+      final: true,
+      message: stored('Provider result, corrected before the high-water.')
+    });
+    expect(corrected.changed).toBe(true);
+    expect(corrected.event.seq).toBeGreaterThan(opened.finalSeq!);
+
+    const token = await providerTurnDrainToken(opened.sessionId, opened.conversationId, opened.turnId);
+    expect(await markProviderBrowserDrained(opened.sessionId, opened.conversationId, opened.turnId, token!)).toBe(true);
+    const marker = await finalizeProviderTurnDrain(opened.sessionId, opened.conversationId, opened.turnId);
+    expect(marker).toMatchObject({ kind: 'turn_drained', finalAssistantSeq: corrected.event.seq });
+  });
+
+  it('quarantines a changed same-turn final after drain without advancing the sealed history', async () => {
+    const opened = await openProviderTurn('completed');
+    const token = await providerTurnDrainToken(opened.sessionId, opened.conversationId, opened.turnId);
+    expect(await markProviderBrowserDrained(opened.sessionId, opened.conversationId, opened.turnId, token!)).toBe(true);
+    const marker = await finalizeProviderTurnDrain(opened.sessionId, opened.conversationId, opened.turnId);
+    expect(marker?.kind).toBe('turn_drained');
+
