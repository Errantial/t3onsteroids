+    expect(restored?.currentProviderTurn).toMatchObject({ state: 'drained', drainedSeq: marker?.seq, finalAssistantSeq: opened.finalSeq });
+    const repaired = JSON.parse(await fs.readFile(file, 'utf8'));
+    expect(repaired.currentProviderTurn).toMatchObject({ state: 'drained', drainedSeq: marker?.seq });
+  });
