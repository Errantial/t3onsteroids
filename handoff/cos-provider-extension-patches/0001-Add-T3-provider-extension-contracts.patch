+import { afterEach, beforeEach, expect, it, vi } from 'vitest';
+import { defaultConfig, initConfigPath, saveConfig } from '../src/main/config.js';
+import { resetAgentsForTests } from '../src/main/agents.js';
+import { spawnAgentWorkers } from '../src/main/agent-admission.js';
+import { dispatch, ok } from '../src/main/mcp/kernel.js';
+import { currentCall } from '../src/main/mcp/call-context.js';
+import { observeRequestCorrelation, resetCorrelationRegistryForTests } from '../src/main/session/correlation.js';
+import { REQUEST_ID_GRACE_MS, recordChatObservations, resetRecorderForTests, tryDrainProviderTurn } from '../src/main/session/recorder.js';
+import {
+  closeProviderTurn,
+  createSession,
+  flushSessions,
+  getSession,
+  initSessionStore,
+  markProviderBrowserDrained,
+  providerTurnDrainToken,
+  readEvents,
+  resetSessionStoreForTests,
+  unsetSessionRootForTests,
+  upsertMessageEvent
+} from '../src/main/session/store.js';
+
+let dir = '';
+
+beforeEach(async () => {
+  dir = await fs.mkdtemp(path.join(os.tmpdir(), 'clf-kernel-provider-'));
+  initConfigPath(dir);
+  initSessionStore(dir);
+  await saveConfig(defaultConfig());
+  resetAgentsForTests();
+  resetCorrelationRegistryForTests();
+  resetRecorderForTests();
+});
+
+afterEach(async () => {
+  await flushSessions();
+  resetRecorderForTests();
+  resetCorrelationRegistryForTests();
+  resetAgentsForTests();
+  resetSessionStoreForTests();
+  unsetSessionRootForTests();
+  if (dir) await fs.rm(dir, { recursive: true, force: true });
+  dir = '';
+});
+
+const stored = (text: string) => ({ text, chars: text.length, truncated: false });
+
+async function activeProviderTurn() {
+  const conversationId = 'provider-kernel-chat';
+  const turnId = 'provider-kernel-turn';
+  const inputId = '11111111-2222-4333-8444-555555555555';
+  const questionId = 'provider-kernel-question';
+  const session = await createSession({
+    conversationId,
+    title: 'Provider kernel task',
+    providerPolicy: { backgroundWork: 'disabled' },
+    currentProviderTurn: { inputId, state: 'admitted' }
+  });
+  await upsertMessageEvent(session.id, {
+    time: 100,
+    source: 'app',
+    kind: 'user_message',
+    messageId: questionId,
+    inputId,
+    inputDelivery: 'confirmed',
+    message: stored('Run provider work.')
+  });
+  await recordChatObservations(conversationId, [
+    { kind: 'turn_start', time: 101, turnId }
+  ]);
+  expect(await getSession(session.id)).toMatchObject({
+    currentProviderTurn: { inputId, state: 'active', turnId }
+  });
+  return { sessionId: session.id, conversationId, turnId };
+}
+
+function prove(requestId: string, conversationId: string, sessionId: string) {
+  expect(observeRequestCorrelation({
+    requestId,
+    conversationId,
+    sessionId,
+    messageId: `${requestId}-message`,
+    tool: 'read',
+    observedAt: Date.now()
+  })).not.toBe('refused');
+}
+
+it('refuses worker admission at the broker owner for an exact provider session', async () => {
+  const owner = await activeProviderTurn();
+  await expect(spawnAgentWorkers({
+    caller: { conversationId: owner.conversationId, sessionId: owner.sessionId },
+    workers: [{ task: 'Must remain in the prime provider turn.' }]
+  }, async () => null, () => false)).rejects.toThrow('PROVIDER_BACKGROUND_WORK_DISABLED');
+});
+
+it('refuses an unproven provider call even when unattributed calls are globally allowed', async () => {
+  const cfg = defaultConfig();
+  await saveConfig({ ...cfg, multiAgent: { ...cfg.multiAgent, allowUnattributedCalls: true } });
+  await activeProviderTurn();
+
+  vi.useFakeTimers();
+  try {
+    let handlerRan = false;
+    const pending = dispatch('agents', { action: 'spawn' }, null, 'provider-unproven', 'core', async () => {
+      handlerRan = true;
+      return ok('must not run');
+    });
+    // Provider identity waits on the exact request-id proof even under the unattributed opt-in.
+    await vi.advanceTimersByTimeAsync(REQUEST_ID_GRACE_MS + 10);
+    const result = await pending;
+    expect(result.isError).toBe(true);
+    expect(JSON.stringify(result)).toContain('PROVIDER_CALLER_IDENTITY_REQUIRED');
+    expect(handlerRan).toBe(false);
+  } finally {
+    vi.useRealTimers();
+  }
+});
+
+it('keeps turn_drained behind an admitted background process completion', async () => {
+  const owner = await activeProviderTurn();
+  prove('provider-background-process', owner.conversationId, owner.sessionId);
+
+  let finishProcess!: (completion: { completedAt: number; durationMs: number; exitCode: number | null }) => void;
+  const processCompletion = new Promise<{ completedAt: number; durationMs: number; exitCode: number | null }>(resolve => {
+    finishProcess = resolve;
+  });
+
+  const launch = await dispatch('exec_command', { cmd: 'background fixture' }, null, 'provider-background-process', 'core', async () => {
+    const context = currentCall()!;
+    context.evidence.processSessionId = '31415';
+    context.evidence.processCompletion = processCompletion;
+    context.evidence.running = true;
+    context.evidence.exitCode = 0;
+    return ok('background process started');
+  });
+  expect(launch.isError).not.toBe(true);
+
+  await recordChatObservations(owner.conversationId, [
+    { kind: 'turn_end', time: 200, turnId: owner.turnId, outcome: 'stopped' }
+  ]);
+  const token = await providerTurnDrainToken(owner.sessionId, owner.conversationId, owner.turnId);
+  expect(token).toEqual(expect.any(String));
+  expect(await markProviderBrowserDrained(owner.sessionId, owner.conversationId, owner.turnId, token!)).toBe(true);
+
+  await tryDrainProviderTurn(owner.sessionId, owner.conversationId);
+  expect((await getSession(owner.sessionId))?.currentProviderTurn?.state).toBe('closing');
+  expect(await readEvents(owner.sessionId, { kinds: ['turn_drained'] })).toEqual([]);
+
+  finishProcess({ completedAt: 300, durationMs: 199, exitCode: 0 });
+  const deadline = Date.now() + 5_000;
+  while ((await getSession(owner.sessionId))?.currentProviderTurn?.state !== 'drained' && Date.now() < deadline) {
+    await new Promise(resolve => setTimeout(resolve, 10));
+  }
+  expect((await getSession(owner.sessionId))?.currentProviderTurn).toMatchObject({ state: 'drained', turnId: owner.turnId });
+
+  const events = await readEvents(owner.sessionId, { kinds: ['tool_call', 'turn_drained'] });
+  const process = events.find(event => event.kind === 'tool_call' && event.call.requestId === 'provider-background-process');
+  const marker = events.find(event => event.kind === 'turn_drained');
+  expect(process?.kind).toBe('tool_call');
+  expect(process?.kind === 'tool_call' ? process.call.process : undefined).toMatchObject({ completedAt: 300, exitCode: 0 });
+  expect(marker?.kind).toBe('turn_drained');
+  expect(marker?.kind === 'turn_drained' ? marker.finalAssistantSeq : undefined).toBeNull();
+  expect(process!.seq).toBeLessThan(marker!.seq);
+});
+
+it('lets an effect admitted before closing settle, but refuses a later exact call before its handler or recorder', async () => {
+  const owner = await activeProviderTurn();
+  prove('provider-pre-close', owner.conversationId, owner.sessionId);
+  prove('provider-post-close', owner.conversationId, owner.sessionId);
+
+  let entered = false;
+  let release!: () => void;
+  const held = new Promise<void>(resolve => { release = resolve; });
+  const first = dispatch('read', { paths: ['/provider/pre'] }, null, 'provider-pre-close', 'core', async () => {
+    entered = true;
+    await held;
+    return ok('pre-close completed');
+  });
+  while (!entered) await new Promise(resolve => setTimeout(resolve, 1));
+
+  expect(await closeProviderTurn(owner.sessionId, owner.turnId, 'completed')).toBe(true);
+  expect((await getSession(owner.sessionId))?.currentProviderTurn).toMatchObject({ state: 'closing', turnId: owner.turnId });
+
+  let postHandlerRan = false;
+  const refused = await dispatch('read', { paths: ['/provider/post'] }, null, 'provider-post-close', 'core', async () => {
+    postHandlerRan = true;
+    return ok('must not run');
+  });
+  expect(refused.isError).toBe(true);
+  expect(JSON.stringify(refused)).toContain('PROVIDER_TURN_CLOSING');
+  expect(postHandlerRan).toBe(false);
+
+  release();
+  const completed = await first;
+  expect(completed.isError).not.toBe(true);
+  expect(JSON.stringify(completed)).toContain('pre-close completed');
+
+  const calls = (await readEvents(owner.sessionId, { kinds: ['tool_call'] }))
+    .filter(event => event.kind === 'tool_call');
+  expect(calls.map(event => event.call.requestId)).toContain('provider-pre-close');
+  expect(calls.map(event => event.call.requestId)).not.toContain('provider-post-close');
+});
