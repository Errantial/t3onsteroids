+  async function maybePublishProviderDrainReady() {
+    const pending = providerDrainPending;
+    if (!pending || pending.invalidated || providerDrainWork || !alive || pending.epoch !== epoch || pending.conversationId !== conversationId ||
+        CLF_DOM.conversationId() !== pending.conversationId || generating || pendingTools !== 0) return false;
+    const current = () => alive && providerDrainPending === pending && !pending.invalidated && pending.epoch === epoch &&
+      conversationId === pending.conversationId && CLF_DOM.conversationId() === pending.conversationId &&
+      fiberSettled?.localTurnId === pending.turnId && !generating && pendingTools === 0;
+    const work = (async () => {
+      // First give turn_end to the worker/app. The probe is authority only when main has durably
+      // entered closing for this exact provider turn; ordinary CoS chats return not-applicable.
+      if (!await flush() || !current()) return false;
+      const probe = await ask({ type: 'provider_turn_drain_ready', phase: 'probe', conversationId: pending.conversationId, turnId: pending.turnId }, current);
+      const probeData = probe?.data || probe || {};
+      if (probe?.ok === true && probeData.applicable === false) { providerDrainPending = null; return true; }
+      const drainToken = probe?.ok === true && probeData.applicable === true && typeof probeData.drainToken === 'string'
+        ? probeData.drainToken : null;
+      if (!drainToken || !current()) return false;
+
+      let nativeTurn = null;
+      if (pending.outcome === 'completed') {
+        const expectedTerminal = pending.terminalMessageId || null;
+        if (!await confirmedProviderTerminal(true, expectedTerminal) || !current()) {
+          // An already-known exact terminal changing across the probe is not a condition that
+          // another quiet scan may heal. Permanently retire this browser barrier; main remains
+          // closing and therefore fails closed (restart recovery marks it broken).
+          if (expectedTerminal && providerDrainPending === pending) pending.invalidated = true;
+          return false;
+        }
+        nativeTurn = fiberTurnFor(currentAssistantTurn());
+        if (!nativeTurn?.endMessageId) return false;
+        if (expectedTerminal && nativeTurn.endMessageId !== expectedTerminal) {
+          pending.invalidated = true;
+          return false;
+        }
+      } else {
+        // Stop/cancel/error turns may have no final assistant message, but must still retain the
+        // exact settled page-turn owner. Silence alone is never terminal authority.
+        const settled = fiberSettled?.localTurnId === pending.turnId ? fiberSettled : null;
+        if (!settled?.pageTurn) return false;
+        if (!await refreshFiber(settled) || !current()) return false;
+        nativeTurn = stampedFiberTurn(settled.pageTurn, [...fiberTurns.values()], fiberScanToken) || fiberTurnFor(settled.pageTurn);
+        if (!nativeTurn) return false;
+      }
+
+      const calls = [...(nativeTurn.calls || [])];
+      if (calls.some(call => !call?.requestId)) return false;
+      await confirmLiveRequestOwners(calls, pending.conversationId, current);
+      if (!current() || calls.some(call => requestOwnersConfirmed.get(call.requestId) !== pending.conversationId)) return false;
+
+      const terminalMessageId = nativeTurn.endMessageId || null;
+      const settledPageTurn = fiberSettled?.localTurnId === pending.turnId ? fiberSettled.pageTurn : null;
+      const pageTurnNode = settledPageTurn?.node || settledPageTurn?.nodes?.[0] || null;
+      const fence = {
+        conversationId: pending.conversationId,
+        turnId: pending.turnId,
+        epoch: pending.epoch,
+        terminalMessageId,
+        drainToken,
