+/** A production provider build may advertise only the exact commit of a clean source tree. */
+export function providerExtensionBuildIdFrom(head: string, status: string): string {
+  const commit = head.trim().toLowerCase();
+  return /^[0-9a-f]{40}$/.test(commit) && status.trim() === '' ? commit : 'development';
+}
+
+function detectProviderExtensionBuildId(): string {
+  try {
+    const options = { cwd: __dirname, encoding: 'utf8' as const };
+    const head = execFileSync('git', ['rev-parse', 'HEAD'], options);
+    const status = execFileSync('git', ['status', '--porcelain=v1', '--untracked-files=normal'], options);
+    return providerExtensionBuildIdFrom(head, status);
+  } catch {
+    return 'development';
+  }
+}
+
+const providerExtensionBuildId = detectProviderExtensionBuildId();
+
 export default defineConfig({
   main: {
     // Keep node_modules external so the MCP SDK ships as real files in the asar
-    // rather than being inlined by the bundler.
+    // rather than being inlined by the bundler. The provider build identity is compiled into
+    // the main bundle so a normal desktop launch cannot accidentally depend on shell env vars.
+    define: { 'process.env.COS_PROVIDER_EXTENSION_BUILD_ID': JSON.stringify(providerExtensionBuildId) },
     plugins: [externalizeDepsPlugin()],
     build: {
       rollupOptions: { input: resolve(__dirname, 'src/main/index.ts') }
