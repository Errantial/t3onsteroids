Subject: [PATCH 07/17] Bind built-in companion to owning CoS instance

---
 extension/background.js       | 35 +++++++++++++++++++-
 src/main/cos-browser/host.ts  |  8 +++++
 src/main/cos-browser/index.ts |  3 +-
 test/extension.test.ts        | 60 +++++++++++++++++++++++++++++++++++
 4 files changed, 104 insertions(+), 2 deletions(-)

diff --git a/extension/background.js b/extension/background.js
index faea56ee..78473804 100644
--- a/extension/background.js
+++ b/extension/background.js
@@ -1082,6 +1082,23 @@ async function hello(candidate) {
   }
 }
 
+/**
+ * The built-in CoS browser belongs to one exact app process. In a side-by-side install another
+ * CoS may already be listening on an earlier discovery port, so generic scanning would pair this
+ * app-owned browser with the wrong process. Its worker preload asks its owning main process for
+ * the exact bridge port; external browsers intentionally keep the normal scan behavior.
+ */
+async function discoveryPorts() {
+  if (!globalThis.__cosBrowserWorker?.call) return PORTS;
+  try {
+    const reply = await globalThis.__cosBrowserWorker.call('cos.bridgePort', []);
+    const own = Number(reply);
+    return Number.isInteger(own) && own >= 1 && own <= 65535 ? [own] : [];
+  } catch {
+    return [];
+  }
+}
+
 /**
  * Which build of this extension is running, as written by scripts/write-extension-stamp.mjs.
  *
@@ -1139,6 +1156,22 @@ function discover(force = false) {
 
 async function discoverNow(force) {
   await load();
+  const candidates = await discoveryPorts();
+  if (globalThis.__cosBrowserWorker && candidates.length === 0) {
+    port = null;
+    portCheckedAt = 0;
+    portCompatible = null;
+    appVersion = null;
+    appProtocol = null;
+    await persist();
+    return null;
+  }
+  if (port !== null && !force && globalThis.__cosBrowserWorker && !candidates.includes(port)) {
+    port = null;
+    if (token !== null) token = null;
+    portCheckedAt = 0;
+    await persist();
+  }
   if (port !== null && !force) {
     if (Date.now() - portCheckedAt < PORT_TRUST_MS) return { port, paired: token !== null, compatible: portCompatible !== false, version: appVersion, bridge: appProtocol };
     const body = await hello(port);
@@ -1151,7 +1184,7 @@ async function discoverNow(force) {
       return { port, paired: body.paired === true, compatible: portCompatible, version: appVersion, bridge: appProtocol };
     }
   }
-  for (const candidate of PORTS) {
+  for (const candidate of candidates) {
     const body = await hello(candidate);
     if (body) {
       if (body.disconnected === true) await latchAppDisconnect();
