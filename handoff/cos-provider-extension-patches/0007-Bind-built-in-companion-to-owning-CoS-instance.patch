diff --git a/test/extension.test.ts b/test/extension.test.ts
index 7cc53163..cfe28f55 100644
--- a/test/extension.test.ts
+++ b/test/extension.test.ts
@@ -3521,6 +3521,66 @@ describe('extension command delivery', () => {
     expect(paths).toContain('/pair');
   });
 
+  it('pins the built-in CoS browser to its owning app bridge instead of another live CoS instance', async () => {
+    const local = new FakeStorageArea({ port: 8765, token: 'old-port-token' });
+    const session = new FakeStorageArea();
+    const seen: Array<{ port: string; path: string }> = [];
+    const fetch = vi.fn(async (input: string) => {
+      const url = new URL(input);
+      seen.push({ port: url.port, path: url.pathname });
+      if (url.pathname === '/hello' && url.port === '8765') return response(200, { app: 'chat-on-steroids', bridge: 14, paired: true });
+      if (url.pathname === '/hello' && url.port === '8766') return response(200, { app: 'chat-on-steroids', bridge: 14, paired: false });
+      if (url.pathname === '/pair' && url.port === '8766') return response(200, { token: 'candidate-token' });
+      return response(404, {});
+    });
+    const workerBridge = {
+      call: vi.fn(async (name: string) => name === 'cos.bridgePort' ? 8766 : null),
+      subscribe: vi.fn()
+    };
+    let listener: ((message: any, sender: any, sendResponse: (value: any) => void) => boolean) | null = null;
+    const chrome = {
+      storage: { local, session },
+      runtime: {
+        id: 'abcdefghijklmnopabcdefghijklmnop',
+        getURL: (file: string) => {
+          if (file === 'build-stamp.txt') throw new Error('No packaged stamp');
+          return `chrome-extension://abcdefghijklmnopabcdefghijklmnop/${file}`;
+        },
+        getManifest: () => ({ version: '1.6.0' }),
+        onMessage: { addListener(fn: typeof listener) { listener = fn; } },
+        onInstalled: { addListener() {} },
+        onStartup: { addListener() {} }
+      },
+      tabs: {
+        query: async () => [],
+        get: async () => { throw new Error('no tab'); },
+        sendMessage: async () => ({ ok: true }),
+        onUpdated: { addListener() {} },
+        onRemoved: { addListener() {} },
+        onCreated: { addListener() {} }
+      },
+      windows: {},
+      scripting: { executeScript: async () => [], insertCSS: async () => undefined },
+      alarms: { create() {}, clear: async () => true, onAlarm: { addListener() {} } }
+    };
+    const original = backgroundSource.replace(/^import .*$/gm, '');
+    vm.runInNewContext(`globalThis.__cosBrowserWorker = __workerBridge;\n${original}`, {
+      __workerBridge: workerBridge,
+      chrome,
+      fetch,
+      AbortController,
+      setTimeout,
+      clearTimeout,
+      URL,
+      TextEncoder,
+      crypto: globalThis.crypto,
+      console
+    }, { filename: 'background.js' });
+    await vi.waitFor(() => expect(local.data.token).toBe('candidate-token'), { timeout: 5_000 });
+    expect(local.data.port).toBe(8766);
+    expect(seen.some(call => call.port === '8765')).toBe(false);
+    expect(seen.some(call => call.port === '8766' && call.path === '/pair')).toBe(true);
+  });
   it('drops a stale token when discovery moves to a different live app port', async () => {
     const local = new FakeStorageArea({ port: 8765, token: 'old-port-token' });
     const session = new FakeStorageArea();
