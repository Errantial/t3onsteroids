       // Model the live boundary directly: after turn_end and the stale post-probe reads, a
@@ -4853,7 +4849,6 @@ describe('canonical Fiber transcript ingestion in 1.8', () => {
       await live.hook.refreshFiber({ pageTurnId: 'provider-raced-wake-page-turn', localTurnId, pageTurn: section });
