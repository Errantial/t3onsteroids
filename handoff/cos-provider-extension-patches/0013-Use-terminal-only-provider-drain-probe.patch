+  /** Terminal identity only, for provider drain revalidation after the full turn was recorded. */
+  function shellTerminalMessageId(fiber, turnId) {
+    let entry = null;
+    for (let at = fiber, up = 0; at && up < 16; up++, at = at.return) {
+      if (Array.isArray(at.memoizedProps?.entry?.turn?.items)) { entry = at.memoizedProps.entry; break; }
+    }
+    if (!entry || !turnId || entry.id !== turnId || entry.turn.items.length > MAX_ROWS) return null;
+    for (let index = entry.turn.items.length - 1; index >= 0; index--) {
+      const item = entry.turn.items[index];
+      if (!item || typeof item !== 'object') continue;
+      if (item.type === 'assistant-message') {
+        if (item.phase !== 'final_answer') continue;
+        return item.completed === true && entry.turn.status === 'complete' ? str(item.messageId) : null;
+      }
+      if (item.type === 'generated-image') {
+        if (entry.turn.status !== 'complete' || item.status !== 'completed' || item.isPreview === true) return null;
+        const id = str(item.chatGptMessageId);
+        if (!id || !Array.isArray(entry.turn.messageIds) || !entry.turn.messageIds.includes(id)) return null;
+        const images = entry.turn.items.filter(candidate => candidate?.type === 'generated-image');
+        return images.every(candidate => str(candidate.chatGptMessageId) && candidate.status === 'completed' && candidate.isPreview !== true)
+          ? id : null;
+      }
+    }
+    return null;
+  }
+
+  function searchTurnTerminalMessageId(turn) {
+    if (!turn || typeof turn !== 'object' || !Array.isArray(turn.items) || turn.items.length > MAX_ROWS) return null;
+    for (let index = turn.items.length - 1; index >= 0; index--) {
+      const item = turn.items[index];
+      if (!item || typeof item !== 'object' || item.type !== 'assistant-message') continue;
+      if (item.phase !== 'final_answer') continue;
+      return item.completed === true && turn.status === 'complete' ? str(item.messageId) || str(item.latestMessageId) : null;
+    }
+    return null;
+  }
+
+  /**
+   * Re-read only the exact terminal id for a turn stamped by the preceding full scan. The
+   * stamp is an ephemeral scan identity, not a page-supplied turn id, and must resolve to one
+   * current mounted turn. No authored text or tool payload is copied through this path.
+   */
+  function terminalSnapshot(stamp) {
+    if (typeof stamp !== 'string' || stamp.length < 3 || stamp.length > 160) return null;
+    let matches;
+    try {
+      matches = [...document.querySelectorAll('[data-clf-fiber-turn]')].filter(node =>
+        node.getAttribute('data-clf-fiber-turn') === stamp && node.matches?.(TURN_SECTION) && !node.closest(OWN_SURFACES) && !onKeptPage(node));
+    } catch { return null; }
+    if (matches.length !== 1) return null;
+    const section = matches[0];
+    const fiber = fiberOf(section);
+    if (!fiber) return null;
+    let endMessageId = null;
+    if (section.matches?.(SHELL_TURN)) {
+      const turnId = str(section.querySelector('[data-content-search-turn-key]')?.getAttribute('data-content-search-turn-key'));
+      endMessageId = shellTerminalMessageId(fiber, turnId);
+    } else if (section.matches?.(SEARCH_TURN_ANCHOR)) {
+      endMessageId = searchTurnTerminalMessageId(turnViewOf(fiber));
+    } else {
+      endMessageId = turnEndMessageId(turnMessagesOf(fiber));
+    }
+    return { stamp, endMessageId };
+  }
