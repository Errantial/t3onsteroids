+  /**
+   * Revalidates one already-stamped page turn without asking MAIN to serialize its transcript.
+   *
+   * Provider drain runs after the complete final has already crossed the ordinary Fiber path.
+   * Re-reading that whole answer just to prove its endMessageId is still current made a 28k
+   * character answer spend more than a second inside turn_end -> turn_drained. The scan stamp
+   * names the exact DOM/Fiber turn that produced the cached descriptor; MAIN re-reads only that
+   * turn's terminal identity. Retry/Regenerate therefore still returns a different/null id and
+   * fails closed, while no authored bytes cross this lightweight boundary.
+   */
+  function askFiberTerminal(pageTurn) {
+    const nodes = pageTurn?.nodes || (pageTurn?.node ? [pageTurn.node] : []);
+    const stamps = [...new Set(nodes.map(node => node?.getAttribute?.('data-clf-fiber-turn')).filter(value =>
+      typeof value === 'string' && value.length > 2 && value.length <= 160))];
+    if (stamps.length !== 1) return Promise.resolve(null);
+    const stamp = stamps[0];
+    const nonce = `${Date.now().toString(36)}-${Math.random().toString(36).slice(2, 10)}`;
+    return new Promise((resolve) => {
+      let done = false;
+      const finish = (value) => {
+        if (done) return;
+        done = true;
+        window.removeEventListener('message', onMessage);
+        resolve(value);
+      };
+      const onMessage = (event) => {
+        if (event.source !== window) return;
+        const data = event.data;
+        if (!data || typeof data !== 'object' || data.source !== FIBER_TERMINAL_REPLY || data.nonce !== nonce || data.v !== 1) return;
+        if (data.stamp !== stamp) return finish(null);
+        const endMessageId = typeof data.endMessageId === 'string' && data.endMessageId.length > 0 && data.endMessageId.length <= 220
+          ? data.endMessageId : null;
+        finish({ endMessageId });
+      };
+      window.addEventListener('message', onMessage);
+      setTimeout(() => finish(null), FIBER_TIMEOUT_MS);
+      try {
+        window.postMessage({ source: FIBER_TERMINAL_ASK, nonce, stamp }, location.origin);
+      } catch {
+        finish(null);
+      }
+    });
+  }
+
   /**
    * Refreshes the cache. `null` means no answer — keep whatever was last known.
    *
