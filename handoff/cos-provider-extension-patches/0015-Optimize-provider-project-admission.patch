+it('revalidates a project while recovering an opening WAL that has no reserved session yet', async () => {
+  const requestedRoot = path.join(directory, 'provider-recovery-root');
+  await fs.mkdir(requestedRoot, { recursive: true });
+  const approved = await validateNewRoot(requestedRoot, []);
+  await saveConfig({ ...defaultConfig(), roots: [{ name: 'provider-recovery', path: approved }] });
+  const project = await addProject(approved);
+  const request = args({ projectId: project.id, providerPolicy: { backgroundWork: 'disabled' } });
+  const row: InputEntry = { ...request, sessionId: request.id, opening: true, state: 'queued', owner: null, createdAt: Date.now(), conversationId: null };
+  await writeDurableNow('session-input', [row]);
+
+  // Simulate a crash after the WAL commit, followed by revocation of the approved root before
+  // restart. The pre-crash admission context is intentionally not durable authority.
+  await saveConfig(defaultConfig());
+  resetInputForTests();
+  expect(await getSession(request.id)).toBeNull();
+
+  const [restored] = await listInputs();
+  expect(restored).toMatchObject({ id: request.id, projectId: project.id, sessionId: request.id });
+  expect(restored?.error).toMatch(/^Local chat setup failed:/);
+  expect((await getSession(request.id))?.projectId).toBeUndefined();
+});
