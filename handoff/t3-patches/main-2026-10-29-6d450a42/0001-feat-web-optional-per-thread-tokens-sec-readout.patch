@@ -0,0 +1,20 @@
+import { describe, expect, it } from "vite-plus/test";
+
+import { toggleThreadInList } from "./threadTokenRatePreference";
+
+describe("toggleThreadInList", () => {
+  it("adds a thread once and removes it again", () => {
+    const on = toggleThreadInList(["a"], "b", true);
+    expect(on).toEqual(["a", "b"]);
+    expect(toggleThreadInList(on, "b", true)).toEqual(["a", "b"]);
+    expect(toggleThreadInList(on, "b", false)).toEqual(["a"]);
+  });
+
+  it("keeps the most recently enabled threads when the cap is hit", () => {
+    const full = Array.from({ length: 500 }, (_, index) => `t${index}`);
+    const next = toggleThreadInList(full, "new", true);
+    expect(next).toHaveLength(500);
+    expect(next[0]).toBe("t1");
+    expect(next.at(-1)).toBe("new");
+  });
+});
diff --git a/apps/web/src/components/chat/threadTokenRatePreference.ts b/apps/web/src/components/chat/threadTokenRatePreference.ts
new file mode 100644
index 0000000000..4ccd7b92e9
--- /dev/null
+++ b/apps/web/src/components/chat/threadTokenRatePreference.ts
@@ -0,0 +1,42 @@
+import { scopedThreadKey } from "@t3tools/client-runtime/environment";
+import type { ScopedThreadRef } from "@t3tools/contracts";
+import * as Schema from "effect/Schema";
+import { useCallback, useMemo } from "react";
+
+import { useLocalStorage } from "../../hooks/useLocalStorage";
+
+const STORAGE_KEY = "t3code:thread-token-rate:v1";
+// Off by default, so only enabled threads are stored. The cap keeps the entry
+// bounded for users who toggle it across many threads over time.
+const MAX_ENABLED_THREADS = 500;
+
+const EnabledThreadsSchema = Schema.Array(Schema.String);
+const NO_THREADS: ReadonlyArray<string> = [];
+
+export function toggleThreadInList(
+  enabledThreads: ReadonlyArray<string>,
+  threadKey: string,
+  enabled: boolean,
+): ReadonlyArray<string> {
+  const rest = enabledThreads.filter((key) => key !== threadKey);
+  return enabled ? [...rest, threadKey].slice(-MAX_ENABLED_THREADS) : rest;
+}
+
+/** Per-thread opt-in for the tokens/sec readout, persisted on this client. */
+export function useThreadTokenRatePreference(threadRef: ScopedThreadRef | null) {
+  const [enabledThreads, setEnabledThreads] = useLocalStorage(
+    STORAGE_KEY,
+    NO_THREADS,
+    EnabledThreadsSchema,
+  );
+  const threadKey = useMemo(() => (threadRef ? scopedThreadKey(threadRef) : null), [threadRef]);
+  const enabled = threadKey !== null && enabledThreads.includes(threadKey);
+  const setEnabled = useCallback(
+    (next: boolean) => {
+      if (threadKey === null) return;
+      setEnabledThreads((current) => toggleThreadInList(current, threadKey, next));
+    },
+    [setEnabledThreads, threadKey],
+  );
+  return { enabled, setEnabled };
+}
diff --git a/apps/web/src/lib/tokenThroughput.test.ts b/apps/web/src/lib/tokenThroughput.test.ts
new file mode 100644
index 0000000000..c4112474a2
--- /dev/null
+++ b/apps/web/src/lib/tokenThroughput.test.ts
@@ -0,0 +1,89 @@
+import type { OrchestrationV2ProviderTurn } from "@t3tools/contracts";
+import * as DateTime from "effect/DateTime";
+import { describe, expect, it } from "vite-plus/test";
+
+import { deriveTokenThroughput, formatTokensPerSecond } from "./tokenThroughput";
+
+type Turn = Parameters<typeof deriveTokenThroughput>[0][number];
+
+const at = (seconds: number) => DateTime.makeUnsafe(Date.UTC(2026, 9, 29, 12, 0, seconds));
+
+function turn(input: {
+  startS: number;
+  endS: number | null;
+  status?: OrchestrationV2ProviderTurn["status"];
+  usage?: Turn["turnTokenUsage"];
+}): Turn {
+  return {
+    status: input.status ?? "completed",
+    startedAt: at(input.startS),
+    completedAt: input.endS === null ? null : at(input.endS),
+    ...(input.usage === undefined ? {} : { turnTokenUsage: input.usage }),
+  };
+}
+
+const complete = (outputTokens: number, hasSubagents = false): Turn["turnTokenUsage"] => ({
+  usageScope: "main_agent",
+  usageStatus: "complete",
+  inputTokens: 1000,
+  outputTokens,
+  hasSubagents,
+});
+
+describe("deriveTokenThroughput", () => {
+  it("divides complete output tokens by turn wall time", () => {
+    const result = deriveTokenThroughput([turn({ startS: 0, endS: 10, usage: complete(500) })]);
+    expect(result).toEqual({ tokensPerSecond: 50, outputTokens: 500, elapsedMs: 10_000 });
+  });
+
+  it("uses the most recent completed turn, ignoring unfinished ones", () => {
+    const result = deriveTokenThroughput([
+      turn({ startS: 0, endS: 10, usage: complete(100) }),
+      turn({ startS: 20, endS: 30, usage: complete(400) }),
+      turn({ startS: 40, endS: null, status: "running", usage: complete(9999) }),
+    ]);
+    expect(result?.tokensPerSecond).toBe(40);
+  });
+
+  it("reports nothing when the provider gave no complete total", () => {
+    expect(deriveTokenThroughput([turn({ startS: 0, endS: 10 })])).toBeNull();
+    expect(
+      deriveTokenThroughput([
+        turn({
+          startS: 0,
+          endS: 10,
+          usage: {
+            usageScope: "main_agent",
+            usageStatus: "partial",
+            outputTokens: 500,
+            hasSubagents: false,
+          },
+        }),
+      ]),
+    ).toBeNull();
+  });
+
+  it("skips subagent turns, zero-token turns and sub-threshold durations", () => {
+    expect(
+      deriveTokenThroughput([turn({ startS: 0, endS: 10, usage: complete(500, true) })]),
+    ).toBeNull();
+    expect(deriveTokenThroughput([turn({ startS: 0, endS: 10, usage: complete(0) })])).toBeNull();
+    expect(
+      deriveTokenThroughput([
+        {
+          status: "completed",
+          startedAt: at(0),
+          completedAt: DateTime.makeUnsafe(Date.UTC(2026, 9, 29, 12, 0, 0, 200)),
+          turnTokenUsage: complete(50),
+        },
+      ]),
+    ).toBeNull();
+  });
+});
+
+describe("formatTokensPerSecond", () => {
+  it("rounds large rates and keeps one decimal for small ones", () => {
+    expect(formatTokensPerSecond(123.4)).toBe("123 tok/s");
+    expect(formatTokensPerSecond(42.26)).toBe("42.3 tok/s");
+  });
+});
diff --git a/apps/web/src/lib/tokenThroughput.ts b/apps/web/src/lib/tokenThroughput.ts
new file mode 100644
index 0000000000..4e3fd434c7
--- /dev/null
+++ b/apps/web/src/lib/tokenThroughput.ts
@@ -0,0 +1,63 @@
+import type { OrchestrationV2ProviderTurn } from "@t3tools/contracts";
+import * as DateTime from "effect/DateTime";
+
+/** Shorter turns are dominated by startup latency, so a rate would mislead. */
+const MIN_ELAPSED_MS = 500;
+
+export interface TokenThroughput {
+  readonly tokensPerSecond: number;
+  readonly outputTokens: number;
+  readonly elapsedMs: number;
+}
+
+type ThroughputTurn = Pick<
+  OrchestrationV2ProviderTurn,
+  "status" | "startedAt" | "completedAt" | "turnTokenUsage"
+>;
+
+function toEpochMs(value: ThroughputTurn["startedAt"]): number | null {
+  if (value === null) return null;
+  const ms = DateTime.toEpochMillis(value);
+  return Number.isFinite(ms) ? ms : null;
+}
+
+/**
+ * Average output tokens per second over the thread's most recent finished
+ * provider turn. Returns null whenever the provider did not report a complete
+ * main-agent total, so the UI shows nothing instead of an estimate.
+ *
+ * Elapsed time is the whole turn (tools and waiting included), not pure
+ * generation time. Turns with subagents are skipped because their wall time
+ * overlaps work the main-agent token count does not cover.
+ */
+export function deriveTokenThroughput(
+  turns: ReadonlyArray<ThroughputTurn>,
+): TokenThroughput | null {
+  let latest: { readonly startedMs: number; readonly turn: ThroughputTurn } | null = null;
+  for (const turn of turns) {
+    if (turn.status !== "completed") continue;
+    const startedMs = toEpochMs(turn.startedAt);
+    if (startedMs === null) continue;
+    // Ties go to the later entry, matching latestProviderTurnTokenUsage.
+    if (latest === null || startedMs >= latest.startedMs) latest = { startedMs, turn };
+  }
+  if (latest === null) return null;
+
+  const usage = latest.turn.turnTokenUsage;
+  if (usage === undefined || usage.usageStatus !== "complete" || usage.hasSubagents) return null;
+  const completedMs = toEpochMs(latest.turn.completedAt);
+  if (completedMs === null) return null;
+  const elapsedMs = completedMs - latest.startedMs;
+  if (elapsedMs < MIN_ELAPSED_MS || usage.outputTokens <= 0) return null;
+
+  return {
+    tokensPerSecond: usage.outputTokens / (elapsedMs / 1000),
+    outputTokens: usage.outputTokens,
+    elapsedMs,
+  };
+}
+
+export function formatTokensPerSecond(tokensPerSecond: number): string {
+  if (tokensPerSecond >= 100) return `${Math.round(tokensPerSecond)} tok/s`;
+  return `${tokensPerSecond.toFixed(1)} tok/s`;
+}
