From e819703412ff9a544fa7ecc9d99b6ace3ce617a2 Mon Sep 17 00:00:00 2001
From: erranter <erranter@users.noreply.github.com>
Date: Fri, 30 Oct 2026 15:48:29 -0600
Subject: [PATCH] feat(web): keep pinned threads in activity order when the
 setting is off

Pinning still stops a thread from settling automatically. The new Pinned threads on top setting (default on) decides whether pinned threads also sit in their own section above the activity list; off sorts them with every other thread and drops the pinned section.
---
 apps/web/src/components/Sidebar.logic.test.ts | 37 +++++++++++++++++++
 apps/web/src/components/Sidebar.logic.ts      |  4 +-
 apps/web/src/components/Sidebar.tsx           |  6 +++
 .../components/settings/SettingsPanels.tsx    | 29 +++++++++++++++
 .../src/components/settings/settingsSearch.ts |  6 +++
 packages/contracts/src/settings.ts            |  4 ++
 6 files changed, 85 insertions(+), 1 deletion(-)

diff --git a/apps/web/src/components/Sidebar.logic.test.ts b/apps/web/src/components/Sidebar.logic.test.ts
index e4fa68a652..b7fc1f8108 100644
--- a/apps/web/src/components/Sidebar.logic.test.ts
+++ b/apps/web/src/components/Sidebar.logic.test.ts
@@ -15,6 +15,7 @@ import {
   pinOrderKeyBetween,
   resolveProjectStatusIndicator,
   resolveSidebarSweepKeys,
+  resolveSidebarThreadSection,
   resolveSidebarThreadStatus,
   resolveThreadStatusPill,
   resolveWorkingStartedAt,
@@ -55,6 +56,42 @@ import {
 
 const localEnvironmentId = EnvironmentId.make("environment-local");
 
+describe("resolveSidebarThreadSection", () => {
+  it("keeps pinned threads on top by default", () => {
+    expect(resolveSidebarThreadSection({ snoozed: false, settled: false, pinned: true })).toBe(
+      "pinned",
+    );
+  });
+
+  it("sorts pinned threads with active ones when pinned threads are not forced on top", () => {
+    expect(
+      resolveSidebarThreadSection({
+        snoozed: false,
+        settled: false,
+        pinned: true,
+        pinnedThreadsOnTop: false,
+      }),
+    ).toBe("active");
+    // Snoozed and settled still win: pinning only changes auto-settlement and the top section.
+    expect(
+      resolveSidebarThreadSection({
+        snoozed: true,
+        settled: false,
+        pinned: true,
+        pinnedThreadsOnTop: false,
+      }),
+    ).toBe("snoozed");
+    expect(
+      resolveSidebarThreadSection({
+        snoozed: false,
+        settled: true,
+        pinned: true,
+        pinnedThreadsOnTop: false,
+      }),
+    ).toBe("settled");
+  });
+});
+
 describe("deleteSelectedThreadEntries", () => {
   const entries = [{ threadKey: "one" }, { threadKey: "two" }, { threadKey: "three" }] as const;
   const success = AsyncResult.success(undefined);
diff --git a/apps/web/src/components/Sidebar.logic.ts b/apps/web/src/components/Sidebar.logic.ts
index efd8244f8c..7d59d78c48 100644
--- a/apps/web/src/components/Sidebar.logic.ts
+++ b/apps/web/src/components/Sidebar.logic.ts
@@ -170,10 +170,12 @@ export function resolveSidebarThreadSection(input: {
   readonly snoozed: boolean;
   readonly settled: boolean;
   readonly pinned: boolean;
+  /** Off: a pinned thread stays in the activity list; pinning only prevents auto-settling. */
+  readonly pinnedThreadsOnTop?: boolean;
 }): SidebarSection {
   if (input.snoozed) return "snoozed";
   if (input.settled) return "settled";
-  if (input.pinned) return "pinned";
+  if (input.pinned && input.pinnedThreadsOnTop !== false) return "pinned";
   return "active";
 }
 
