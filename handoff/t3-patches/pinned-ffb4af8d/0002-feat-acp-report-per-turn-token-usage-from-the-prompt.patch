+        ),
+      ).flatMap((event) => (event.type === "provider_turn.updated" ? [event.providerTurn] : []));
+      const completed = turns.findLast((turn) => turn.status === "completed");
+      assert.isDefined(completed);
+      if (expected === undefined) {
