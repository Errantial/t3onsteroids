diff --git a/packages/provider-acp/src/server/turnTokenUsage.test.ts b/packages/provider-acp/src/server/turnTokenUsage.test.ts
new file mode 100644
index 0000000000..dc3d5e4c0c
--- /dev/null
+++ b/packages/provider-acp/src/server/turnTokenUsage.test.ts
@@ -0,0 +1,49 @@
+import { describe, expect, it } from "vite-plus/test";
+
+import { acpTurnTokenUsage } from "./turnTokenUsage.ts";
+
+const usage = (extra: Record<string, number | null> = {}) => ({
+  totalTokens: 150,
+  inputTokens: 100,
+  outputTokens: 50,
+  ...extra,
+});
+
+describe("acpTurnTokenUsage", () => {
+  it("reports nothing when the agent sent no usage", () => {
+    expect(acpTurnTokenUsage(undefined, false)).toBeUndefined();
+    expect(acpTurnTokenUsage(null, false)).toBeUndefined();
+  });
+
+  it("maps input and output as a complete total", () => {
+    expect(acpTurnTokenUsage(usage({ cachedReadTokens: 20, cachedWriteTokens: 5 }), false)).toEqual(
+      {
+        usageScope: "main_agent",
+        usageStatus: "complete",
+        hasSubagents: false,
+        inputTokens: 100,
+        outputTokens: 50,
+        cachedInputTokens: 20,
+        cacheCreationTokens: 5,
+      },
+    );
+  });
+
+  it("treats a report with thought tokens as partial because ACP leaves their accounting open", () => {
+    expect(acpTurnTokenUsage(usage({ thoughtTokens: 30 }), false)).toMatchObject({
+      usageStatus: "partial",
+      outputTokens: 50,
+      reasoningTokens: 30,
+    });
+    expect(acpTurnTokenUsage(usage({ thoughtTokens: 0 }), false)?.usageStatus).toBe("complete");
+  });
+
+  it("rejects malformed counts instead of guessing", () => {
+    expect(acpTurnTokenUsage(usage({ outputTokens: -1 }), false)).toBeUndefined();
+    expect(acpTurnTokenUsage(usage({ inputTokens: 1.5 }), false)).toBeUndefined();
+  });
+
+  it("flags subagent turns", () => {
+    expect(acpTurnTokenUsage(usage(), true)?.hasSubagents).toBe(true);
+  });
+});
diff --git a/packages/provider-acp/src/server/turnTokenUsage.ts b/packages/provider-acp/src/server/turnTokenUsage.ts
new file mode 100644
index 0000000000..f5622c5aec
--- /dev/null
+++ b/packages/provider-acp/src/server/turnTokenUsage.ts
@@ -0,0 +1,42 @@
+import type { TurnTokenUsage } from "@t3tools/contracts";
+import type * as EffectAcpSchema from "effect-acp/compat";
+
+/**
+ * Maps the usage an ACP agent reports for a finished prompt into T3's
+ * normalized per-turn usage. ACP marks this field unstable and does not say
+ * whether `outputTokens` already includes `thoughtTokens`, so a report that
+ * carries thought tokens is only `partial`: the count is valid but may leave
+ * the reasoning share out, and consumers such as the tokens/sec readout skip
+ * partial totals rather than understate a rate.
+ */
+export function acpTurnTokenUsage(
+  usage: EffectAcpSchema.Usage | null | undefined,
+  hasSubagents: boolean,
+): TurnTokenUsage | undefined {
+  if (usage === null || usage === undefined) return undefined;
+  const valid = (value: number | null | undefined): value is number =>
+    typeof value === "number" && Number.isSafeInteger(value) && value >= 0;
+  if (!valid(usage.inputTokens) || !valid(usage.outputTokens)) return undefined;
+
+  const common = {
+    usageScope: "main_agent" as const,
+    hasSubagents,
+    ...(valid(usage.cachedReadTokens) ? { cachedInputTokens: usage.cachedReadTokens } : {}),
+    ...(valid(usage.cachedWriteTokens) ? { cacheCreationTokens: usage.cachedWriteTokens } : {}),
+    ...(valid(usage.thoughtTokens) ? { reasoningTokens: usage.thoughtTokens } : {}),
+  };
+  const mayExcludeThoughts = valid(usage.thoughtTokens) && usage.thoughtTokens > 0;
+  return mayExcludeThoughts
+    ? {
+        ...common,
+        usageStatus: "partial",
+        inputTokens: usage.inputTokens,
+        outputTokens: usage.outputTokens,
+      }
+    : {
+        ...common,
+        usageStatus: "complete",
+        inputTokens: usage.inputTokens,
+        outputTokens: usage.outputTokens,
+      };
+}
