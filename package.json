{
  "name": "t3onsteroids",
  "version": "1.1.1",
  "private": true,
  "description": "T3 Code compatibility bridge for Chat On Steroids",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "t3onsteroids": "dist/cli/index.js"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "package:smoke": "node dist/cli/index.js --release-readiness",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "pretest": "npm run build",
    "test": "vitest run --maxWorkers=1",
    "verify": "npm run typecheck && npm run lint && npm test && npm run package:smoke",
    "step7:evaluate": "node scripts/evaluate-step7-performance.mjs",
    "dev": "node --enable-source-maps dist/cli/index.js"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "1.9.0",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "24.7.2",
    "eslint": "9.39.5",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vite-node": "6.0.0",
    "vitest": "5.0.5"
  }
}
